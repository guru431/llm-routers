#!/bin/sh
# pre-commit secret-guard for a PUBLIC repository.
# Blocks commits that add sensitive files, high-entropy key formats, or
# personal strings listed in an untracked .sanitize-patterns file.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass a confirmed false positive:   git commit --no-verify
set -eu

repo_root=$(git rev-parse --show-toplevel)
fail=0

# 1) Block sensitive filenames entering the tree (allow *.example templates).
# ACMR (not just A) so a rename/copy INTO a sensitive name is caught by its
# destination path — --name-only prints the new path for renames.
# The .env pattern uses (\..+)? so multi-suffix names like .env.production.local
# are matched too (the single-suffix form missed them); templates are re-included.
#
# The template exemption is applied to the BASENAME, and only as a trailing
# `.example` suffix. Applying it to the whole path (the previous `grep -ivE
# '\.example(\.|$)'`) meant ANY directory containing `.example.` in its name
# exempted everything under it: `foo.example.bar/id_rsa` sailed through the
# filename check entirely. A template is a file named `<something>.example`,
# never a file that merely lives under such a directory.
added=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$added" ]; then
  bad=$(printf '%s\n' "$added" \
    | grep -iE '(^|/)(\.env(\..+)?$|.*\.pem$|.*\.key$|.*\.p12$|.*\.pfx$|id_rsa|id_ed25519|id_dsa|vault\.env|\.sanitize-patterns$)' \
    | awk -F/ '{ b = tolower($NF); if (b !~ /\.example$/) print }' || true)
  if [ -n "$bad" ]; then
    echo "BLOCKED: refusing to commit sensitive file(s):"
    printf '  %s\n' $bad
    fail=1
  fi
fi

# 1b) Reject newly added binary files. `git diff --cached --numstat` reports
# binary blobs as "-<TAB>-<TAB><path>"; text files report numeric add/del counts.
# Note: grep ERE does not portably treat \t as a tab, so use a literal tab.
tab=$(printf '\t')
binstat=$(git diff --cached --numstat --diff-filter=A 2>/dev/null || true)
if [ -n "$binstat" ]; then
  binfiles=$(printf '%s\n' "$binstat" | grep -E "^-${tab}-${tab}" | cut -f3- || true)
  if [ -n "$binfiles" ]; then
    echo "BLOCKED: binary file staged, use --no-verify if intentional:"
    printf '  %s\n' $binfiles
    fail=1
  fi
fi

# 1c) Reject newly-added runtime/bench artifacts. These are gitignored, but a
# `git add -f` could still stage them — they carry provider error bodies, account
# ids, reasoning traces and prompt echoes. Anchored to the exact dirs to avoid
# catching an unrelated doc that happens to end in .jsonl.
if [ -n "$added" ]; then
  arts=$(printf '%s\n' "$added" \
    | grep -iE '(^|/)(bench/results/.*\.(jsonl|log)$|logs/|_srv_[^/]*\.txt$)' || true)
  if [ -n "$arts" ]; then
    echo "BLOCKED: runtime/bench artifact staged (gitignored; use --no-verify only if truly intended):"
    printf '  %s\n' $arts
    fail=1
  fi
fi

# Collect staged diff once. Exclude ONLY this pre-commit file (its regex
# constants would self-match the token formats below) — other files under
# .githooks/ ARE scanned, so a concrete token pasted into a sibling hook is caught.
# Scan only ADDED lines (leading '+', minus the '+++' file header): a commit that
# REMOVES a leaked value (e.g. untracking bench/results) must not be blocked by
# the secret it is deleting — only newly INTRODUCED secrets matter.
diff_content=$(git diff --cached --unified=0 -- . ':(exclude).githooks/pre-commit' 2>/dev/null || git diff --cached --unified=0)
added_content=$(printf '%s\n' "$diff_content" | grep '^+' | grep -v '^+++' || true)

# 2) High-confidence secret/token formats (generic, very low false-positive)
generic='-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|gho_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{16,}|gsk_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{35}|ccr-[A-Za-z0-9]{8,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+|[0-9]{8,10}:[A-Za-z0-9_-]{35}|user_[A-Za-z0-9]{20,}'
hits=$(printf '%s\n' "$added_content" | grep -nE -e "$generic" || true)
if [ -n "$hits" ]; then
  echo "BLOCKED: possible secret/token format in staged changes:"
  printf '%s\n' "$hits" | sed 's/^/  /'
  fail=1
fi

# 3) Personal denylist — concrete values from untracked .sanitize-patterns.
# Matched as FIXED strings (-F): the file holds literal values, so regex
# metacharacters must not be interpreted and an invalid regex must not silently
# disable the check. A scanner error (grep rc>1) fails the commit closed instead
# of being swallowed as a no-hit. trap guarantees the temp file is removed.
sp="$repo_root/.sanitize-patterns"
if [ -f "$sp" ]; then
  pat=$(mktemp 2>/dev/null || echo "$repo_root/.sanitize-patterns.tmp")
  trap 'rm -f "$pat"' EXIT
  grep -vE '^[[:space:]]*$' "$sp" > "$pat" 2>/dev/null || true
  if [ -s "$pat" ]; then
    rc=0
    hits=$(printf '%s\n' "$added_content" | grep -inFf "$pat") || rc=$?
    if [ "$rc" -gt 1 ]; then
      echo "BLOCKED: .sanitize-patterns scan failed (grep rc=$rc) — refusing to commit."
      fail=1
    elif [ -n "$hits" ]; then
      echo "BLOCKED: personal data (matched .sanitize-patterns) in staged changes:"
      printf '%s\n' "$hits" | sed 's/^/  /'
      fail=1
    fi
  fi
  rm -f "$pat"
  trap - EXIT
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit aborted — this is a PUBLIC repository."
  echo "Fix the lines above, or for a confirmed false positive: git commit --no-verify"
  exit 1
fi
exit 0
