__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.venv/
venv/
*.egg-info/
build/
dist/
logs/
mcp-*/logs/

# Claude Code local settings (могут содержать API-ключи)
.claude/

# CCR config содержит API-ключи (см. claude-code-router/README.md, template — config.example.json)
claude-code-router/config.json

# Key vault (если используете bench/ с локальным vault)
secrets/

# Internal design docs (kept local, not published)
docs/

# Local working notes — may reference internal paths/projects; never publish
FINDINGS.md
IDEAS.md

# Backlog status manifest — echoes private FINDINGS/IDEAS titles; regenerated by
# scripts/backlog_manifest.py, never committed.
backlog/manifest.json

# local-only secret denylist for pre-commit hook (never commit)
.sanitize-patterns

# Per-server runtime secrets (agent bearer tokens) — never commit
.env
*/.env

# Agent-server runtime debug logs (may contain private IPs / prompt text)
*/_srv_*.txt

# Bench raw runtime artifacts (provider error bodies incl. account ids, reasoning
# traces, prompt echoes) — never publish. Aggregate numbers live in the report md.
bench/results/
